# Hyprspace starter config.
#
# This file is intentionally small. Hyprspace already provides opinionated built-in
# defaults for the dwindle-friendly layout behavior, so this file only contains the
# first shortcuts new users are likely to want immediately.
#
# For a fuller reference config, see: ~/.config/hyprspace/docs/default-config.toml
# For path rules, see: ~/.config/hyprspace/docs/README.md
# For all available config options and commands, see:
# https://nikitabobko.github.io/AeroSpace/guide
# https://nikitabobko.github.io/AeroSpace/commands

config-version = 2
start-at-login = true
persistent-workspaces = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]



# Hold alt and drag from anywhere inside a tiled window to move and reinsert it at the drop point.
[mouse-drag]
enabled = true
modifier = 'alt'

[gaps]
inner.horizontal = 14
inner.vertical = 14
outer.left = 8
outer.right = 8
outer.bottom = 8
outer.top = [{ monitor."built-in" = 8 }, { monitor."main" = 24 }, 24]

# ---------- MAIN KEY BINDINGS -----------

[mode.main.binding]
alt-enter = 'new-window-or-open Ghostty'
alt-b = 'new-window-or-open Safari'
alt-m = 'new-window-or-open Music'
alt-shift-p = 'open-terminal Ghostty btop'

alt-1 = 'workspace 1'
alt-2 = 'workspace 2'
alt-3 = 'workspace 3'
alt-4 = 'workspace 4'
alt-5 = 'workspace 5'
alt-6 = 'workspace 6'
alt-7 = 'workspace 7'
alt-8 = 'workspace 8'
alt-9 = 'workspace 9'
alt-0 = 'workspace 0'

alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'
alt-shift-5 = 'move-node-to-workspace 5'
alt-shift-6 = 'move-node-to-workspace 6'
alt-shift-7 = 'move-node-to-workspace 7'
alt-shift-8 = 'move-node-to-workspace 8'
alt-shift-9 = 'move-node-to-workspace 9'
alt-shift-0 = 'move-node-to-workspace 0'

alt-h = 'focus left'
alt-j = 'focus down'
alt-k = 'focus up'
alt-l = 'focus right'

alt-shift-h = 'move left'
alt-shift-j = 'move down'
alt-shift-k = 'move up'
alt-shift-l = 'move right'

# Swap the focused window with its neighbor.
alt-shift-left = 'swap left'
alt-shift-right = 'swap right'
alt-shift-up = 'swap up'
alt-shift-down = 'swap down'

alt-tab = 'focus-back-and-forth'
alt-shift-space = 'layout floating tiling'
alt-shift-semicolon = 'mode service'
alt-shift-slash = 'layout tiles horizontal vertical'
alt-shift-comma = 'layout accordion horizontal vertical'
# Resize the focused window. On a popped-out (floating) window these resize around
# its center, so it grows and shrinks evenly on all sides.
#   alt -/=  (minus/equal)       width
#   alt _/+  (shift minus/equal) height
alt-minus = 'resize width -50'
alt-equal = 'resize width +50'
alt-shift-minus = 'resize height -50'
alt-shift-equal = 'resize height +50'
alt-f = 'fullscreen'
alt-cmd-f = 'macos-native-fullscreen'

# ---------- SERVICE MODE -----------

[mode.service.binding]
esc = ['reload-config', 'mode main']
r = ['flatten-workspace-tree', 'mode main']
f = ['layout floating tiling', 'mode main']
alt-shift-semicolon = 'mode main'

# ---------- WINDOW CONTROL -----------

[[on-window-detected]]
if.app-id = "com.apple.ScreenSharing"
run = ["layout floating"]

[[on-window-detected]]
if.app-id = "com.apple.MobileSMS"
run = ["layout floating"]

[[on-window-detected]]
if.app-id = 'com.apple.iphonesimulator'
run = ["layout floating"]

#[[on-window-detected]]
#if.app-id = 'com.tinyspeck.slackmacgap'
#run = ['layout floating']

[[on-window-detected]]
if.app-id = "com.microsoft.teams2"
run = ["layout floating"]

[[on-window-detected]]
if.app-id = 'com.macpaw.CleanMyMac'
run = ["layout floating"]

[[on-window-detected]]
if.app-id = "com.macpaw.CleanMyMac4"
run = ["layout floating"]

[[on-window-detected]]
if.app-id = "com.apple.QuickTimePlayerX"
run = ["layout floating"]
